NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://upcycle:local_development@localhost:5432/upcycle
# For migrations, prefer an unpooled PostgreSQL connection.
DIRECT_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FRONTEND_URL=http://localhost:5173,http://localhost:8081
# Set the exact number of trusted reverse proxy hops in deployment.
TRUST_PROXY_HOPS=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
