          "required": true,
          "min": 0.001
        },
        {
          "key": "photoUrl",
          "label": "Photo proof",
          "type": "asset",
          "required": false,
          "uploadEndpoint": "/upload/waste-photo",
          "formKey": "image",
          "multiple": false,
          "maxFiles": 1
