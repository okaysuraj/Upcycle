  {
    "key": "vendors",
    "title": "Vendors & verification",
    "group": "Marketplace",
    "endpoint": "/marketplace/vendors",
    "columns": [
      {
        "key": "name",
        "label": "Vendor",
        "type": "text",
        "required": false
      },
      {
        "key": "email",
        "label": "Email",
        "type": "text",
        "required": false
      },
      {
        "key": "kycStatus",
        "label": "Verification status",
        "type": "text",
        "required": false
      },
      {
        "key": "isActive",
        "label": "Active",
        "type": "text",
        "required": false
      }
    ],
    "roles": ["ADMIN", "PLATFORM_ADMIN", "CAMPUS_ADMIN", "STAFF", "WASTE_STAFF"],
    "actions": [
      {
        "label": "Approve verification",
        "endpoint": "/marketplace/vendors/{id}/verify",
        "method": "PATCH",
        "body": {
          "status": "VERIFIED"
        },
        "roles": ["ADMIN", "PLATFORM_ADMIN"],
        "fields": [],
        "confirm": true,
        "when": {
          "kycStatus": "PENDING"
        }
      },
      {
        "label": "Reject verification",
        "endpoint": "/marketplace/vendors/{id}/verify",
        "method": "PATCH",
        "body": {
          "status": "REJECTED"
        },
        "roles": ["ADMIN", "PLATFORM_ADMIN"],
        "fields": [],
        "confirm": true,
        "when": {
          "kycStatus": "PENDING"
        }
      }
    ],
    "nested": ["vendorVerifications"],
    "kind": "records",
    "export": true,
    "toolbar": []
  },
