{
  "expo": {
    "name": "Upcycle",
    "slug": "upcycle-mobile",
    "scheme": "upcycle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upcycle.campus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafaf8"
      },
      "package": "com.upcycle.campus"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fafaf8"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Upcycle to scan bin QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Upcycle to attach selected photos to your saved records.",
          "cameraPermission": "Allow Upcycle to take a photo for your saved records.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
